---
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isAbout = pathname.startsWith('/about');
const isBlog = pathname.startsWith('/blog');
---

<nav class="navbar">
	<a href="/" class="nav-brand" data-astro-prefetch="load">
		<svg class="brand-icon" width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
			<circle cx="14" cy="14" r="13" fill="url(#dropGrad)" opacity="0.15"/>
			<path d="M14 4C14 4 7 12 7 17a7 7 0 0 0 14 0c0-5-7-13-7-13z" fill="url(#dropGrad)"/>
			<path d="M10.5 18.5C10.5 16.5 12 15 14 15" stroke="white" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/>
			<defs>
				<linearGradient id="dropGrad" x1="14" y1="4" x2="14" y2="24" gradientUnits="userSpaceOnUse">
					<stop offset="0%" stop-color="#38bdf8"/>
					<stop offset="100%" stop-color="#0284c7"/>
				</linearGradient>
			</defs>
		</svg>
		<span class="brand-text">Pool Cleaning Cyprus</span>
	</a>
	<div class="nav-links">
		<a href="/" class={`nav-item ${isHome ? 'active' : ''}`} data-astro-prefetch="load">Home</a>
		<a href="/about" class={`nav-item ${isAbout ? 'active' : ''}`} data-astro-prefetch="load">About</a>
		<a href="/#pricing" class="nav-item" data-astro-prefetch="load">Prices</a>
		<a href="/blog" class={`nav-item ${isBlog ? 'active' : ''}`} data-astro-prefetch="load">Blog</a>
	</div>
	<a href="https://wa.me/35797603083" target="_blank" rel="noopener noreferrer" class="whatsapp-btn" aria-label="Chat on WhatsApp">
		<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
	</a>
</nav>

<style>
	.navbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 8px;
		z-index: 1000;
		background: rgba(255, 255, 255, 0.88);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		padding: 0 32px;
		height: 64px;
		border-bottom: 1px solid rgba(0, 0, 0, 0.08);
		box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
	}

	.nav-brand {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		margin-right: auto;
		flex-shrink: 0;
	}

	.brand-icon {
		flex-shrink: 0;
	}

	.brand-text {
		font-size: 1rem;
		font-weight: 700;
		color: #0c1a2e;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	:global(html.dark) .brand-text {
		color: #e0f2fe;
	}

	:global(html.dark) .navbar {
		background: rgba(10, 22, 40, 0.92);
		border-color: rgba(255, 255, 255, 0.08);
		box-shadow: 0 2px 16px rgba(0, 0, 0, 0.4);
	}

	.nav-links {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 2px;
	}

	.nav-item {
		display: flex;
		align-items: center;
		padding: 8px 14px;
		border-radius: 8px;
		color: rgba(45, 55, 72, 0.65);
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		transition: all 0.2s ease;
		white-space: nowrap;
	}

	.nav-item:hover {
		color: #0ea5e9;
		background: rgba(14, 165, 233, 0.08);
	}

	.nav-item.active {
		color: #0ea5e9;
		background: rgba(14, 165, 233, 0.1);
	}

	.whatsapp-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background: #25d366;
		color: #fff;
		transition: background 0.2s ease;
		flex-shrink: 0;
	}

	.whatsapp-btn:hover {
		background: #1ebe5d;
	}

	@media (max-width: 768px) {
		.navbar {
			padding: 0 16px;
			height: 56px;
		}
		.brand-text {
			font-size: 0.85rem;
		}
		.nav-item {
			padding: 6px 8px;
			font-size: 0.78rem;
		}
	}

	@media (max-width: 480px) {
		.nav-links {
			gap: 0;
		}
		.nav-item {
			padding: 5px 6px;
			font-size: 0.74rem;
		}
		.brand-text {
			display: none;
		}
	}
</style>

<script is:inline>
	(function() {
		var pathname = window.location.pathname;
		document.querySelectorAll('.nav-item').forEach(function(item) {
			var href = item.getAttribute('href');
			item.classList.remove('active');
			if (href === '/' && pathname === '/') item.classList.add('active');
			else if (href !== '/' && pathname.startsWith(href)) item.classList.add('active');
		});
	})();

	document.addEventListener('astro:after-swap', function() {
		var pathname = window.location.pathname;
		document.querySelectorAll('.nav-item').forEach(function(item) {
			var href = item.getAttribute('href');
			item.classList.remove('active');
			if (href === '/' && pathname === '/') item.classList.add('active');
			else if (href !== '/' && pathname.startsWith(href)) item.classList.add('active');
		});
	});
</script>
