---
import Navbar from '../../components/Navbar.astro';
import { ClientRouter } from 'astro:transitions';
import { alternates } from '../../data/i18n';
import { Droplets, FlaskConical, Filter, Leaf, Wrench, Waves, Snowflake, Search, Sparkles, ChevronDown, Camera, MapPin, Clock, Gauge, Receipt, ShieldCheck } from '@lucide/astro';
import { site } from '../../data/content';

const title = 'Poolreinigung Paphos (Poolpflege Paphos) | Pool Cleaning Cyprus';
const description = 'Professionelle Poolreinigung in Paphos, Coral Bay, Peyia, Kissonerga, Chloraka, Tala, Geroskipou & mehr. Wöchentliche Poolpflege ab €45. Jetzt kostenloses Angebot anfordern!';
const url = `${site.url}/de/pool-cleaning-paphos/`;
const phone = '+35797603083';
const whatsapp = 'https://wa.me/35797603083';

const services = [
	{ icon: Droplets, title: 'Wöchentliche Poolreinigung', text: 'Unsere regelmäßige Poolreinigung umfasst das Abschöpfen von Laub und Schmutz von der Wasseroberfläche, das Saugen des Poolbodens, das Bürsten von Wänden und Stufen sowie die Reinigung der Wasserlinie. Außerdem leeren wir die Skimmer- und Pumpenkörbe, damit das Wasser richtig umgewälzt wird. Regelmäßige Reinigung verhindert, dass sich Schmutz, Staub und organisches Material ansammeln, und hält Ihren Pool in bestem Zustand.' },
	{ icon: FlaskConical, title: 'Wassertests & chemischer Ausgleich', text: 'Die richtige Wasserchemie ist entscheidend für einen sauberen und angenehmen Pool. Bei unseren planmäßigen Besuchen testen wir Chlor, pH-Wert, Gesamtalkalinität, Kalkhärte und Stabilisator (Cyanursäure). Anhand der Messwerte gleichen wir die Chemie aus und berücksichtigen dabei das harte Wasser und die starke Sonne Zyperns. Der richtige Stabilisator-Wert schützt das Chlor vor der intensiven Sonne, und bei wiederkehrenden Algen prüfen wir zusätzlich den Phosphatgehalt.' },
	{ icon: Sparkles, title: 'Kalk- & Fliesenreinigung', text: 'Hartes Wasser in Paphos hinterlässt weiße Kalkablagerungen an Fliesen, Wasserlinie und Armaturen. Wir entfernen Kalkbeläge von Fliesen und Wasserlinie und halten die Kalkhärte unter Kontrolle, damit die Ablagerungen nicht so schnell zurückkehren.' },
	{ icon: Filter, title: 'Filterreinigung & -wartung', text: 'Ihre Filteranlage spielt eine wichtige Rolle für klares Poolwasser. Wir kontrollieren Filter und Druckwerte und führen bei Bedarf Rückspülung und Nachspülung durch. Außerdem prüfen wir Pumpenkörbe, Skimmer und weitere Komponenten der Filteranlage, damit die Umwälzung stimmt und die Technik nicht unnötig belastet wird.' },
	{ icon: Leaf, title: 'Algenvorbeugung & Behandlung grüner Pools', text: 'Warmes Wetter und zu niedrige Chlorwerte begünstigen Algenwachstum. Regelmäßige Poolpflege beugt Algen vor, indem Wasserchemie, Filterung und Umwälzung überwacht werden. Ist Ihr Pool bereits grün geworden, bieten wir die Rettung an: Schockchlorung, Bürsten, Filterung und Wasserausgleich, bis der Pool wieder klar ist.' },
	{ icon: Wrench, title: 'Pumpen- & Technikreparaturen', text: 'Wir prüfen und reparieren Pooltechnik in Paphos, darunter Poolpumpen, Filter, Skimmer, Rohrleitungen, Poolbeleuchtung und weitere Komponenten. Wer Technikprobleme früh erkennt, vermeidet teurere Reparaturen und Unterbrechungen der regelmäßigen Poolpflege. Außerdem warten wir Pool-Wärmepumpen, Solarheizungen, Poolroboter, Abdeckungen und Poolautomatisierung.' },
	{ icon: Search, title: 'Leckortung am Pool', text: 'Verliert Ihr Pool mehr Wasser, als die Verdunstung erklärt? Wir prüfen Rohrleitungen, Armaturen, Skimmer und die Poolschale auf Undichtigkeiten und organisieren die Reparatur. Falls nötig, können wir den Pool auch ablassen und neu befüllen.' },
	{ icon: Waves, title: 'Pflege von Salzwasserpools', text: 'Wir betreuen auch Salzwasserpools. Unser Service umfasst Salzgehalt-Tests, Kontrolle der Salzzelle und Anpassungen der Wasserchemie. Ob Ihr Pool mit klassischem Chlor oder mit Salzelektrolyse arbeitet, wir halten das Wasser im Gleichgewicht.' },
	{ icon: Snowflake, title: 'Winterpflege & saisonale Öffnung', text: 'Auch in der Nebensaison brauchen Pools auf Zypern Pflege. Unser Winterpflegeplan hält das Wasser ausgeglichen und die Technik geschützt, mit selteneren Besuchen. Im Frühjahr übernehmen wir die Poolöffnung, damit Ihr Pool sauber und bereit für den Sommer ist.' },
];

const areas = ['Coral Bay', 'Peyia', 'Kissonerga', 'Chloraka', 'Tala', 'Paphos Stadt', 'Universal', 'Geroskipou', 'Konia', 'Emba', 'Tsada', 'Tremithousa', 'Armou', 'Mesogi', 'Kathikas', 'Kouklia', 'Aphrodite Hills', 'Polis', 'Latchi'];
const areasEn = ['Coral Bay', 'Peyia', 'Kissonerga', 'Chloraka', 'Tala', 'Paphos Town', 'Universal', 'Geroskipou', 'Konia', 'Emba', 'Tsada', 'Tremithousa', 'Armou', 'Mesogi', 'Kathikas', 'Kouklia', 'Aphrodite Hills', 'Polis', 'Latchi'];

const why = [
	{ icon: Clock, title: 'Zuverlässige feste Termine', text: 'Ihr Pool wird regelmäßig nach vereinbartem Rhythmus betreut. Muss ein Termin verschoben werden, sagen wir es Ihnen rechtzeitig.' },
	{ icon: MapPin, title: 'Lokales Wissen', text: 'Wir kennen die Auswirkungen von hartem Wasser, Sommerhitze, Staub und starker Sonne auf Pools in Paphos.' },
	{ icon: Gauge, title: 'Gemessene Wasserchemie', text: 'Wir messen die Wasserwerte und dosieren die Chemie anhand tatsächlicher Messwerte statt nach Gefühl.' },
	{ icon: Receipt, title: 'Transparente Preise', text: 'Sie erhalten vor Arbeitsbeginn klare Preise, ohne unerwartete Kosten bei planmäßigen Besuchen.' },
	{ icon: Camera, title: 'Fotobericht nach jeder Reinigung', text: 'Sie sehen, was erledigt wurde und in welchem Zustand Ihr Pool ist, auch wenn Sie nicht auf Zypern sind.' },
	{ icon: ShieldCheck, title: 'Komplette Poolpflege', text: 'Von der regelmäßigen Reinigung und dem Wasserausgleich bis zu Technikreparaturen und der Rettung grüner Pools bieten wir das gesamte Leistungsspektrum.' },
];

const faqs = [
	{ q: 'Was kostet die Poolreinigung in Paphos?', a: 'Unser wöchentlicher Reinigungsplan kostet €45 pro Besuch, die zweiwöchentliche Reinigung beginnt bei €60 pro Besuch, jeweils inklusive Chemikalien. Große Pools, Gemeinschaftspools und Einmalreinigungen werden individuell kalkuliert.' },
	{ q: 'Wie oft sollte ein Pool auf Zypern gereinigt werden?', a: 'Im Sommer empfehlen wir wöchentliche Reinigung, weil Hitze, Sonne und Staub die Wasserqualität schnell beeinflussen. Im Winter reichen meist Besuche alle zwei bis vier Wochen.' },
	{ q: 'Reinigen Sie Pools auch im Winter?', a: 'Ja. Wir bieten Winterpflege mit selteneren Besuchen an, damit das Wasser ausgeglichen bleibt und Ihre Technik bis zur Badesaison geschützt ist.' },
	{ q: 'Können Sie den Pool reinigen, bevor meine Gäste ankommen?', a: 'Ja. Wir bieten Reinigungen vor der Anreise und Einmalreinigungen für Ferienunterkünfte und Airbnb-Objekte an, mit Fotobericht, damit Sie wissen, dass der Pool bereit ist.' },
	{ q: 'Mein Pool ist grün geworden. Können Sie das beheben?', a: 'Ja. Unsere Rettung grüner Pools nutzt Schockchlorung, Bürsten, Filterung und Wasserausgleich, um den Pool zu klären, in der Regel innerhalb weniger Besuche.' },
	{ q: 'Muss ich beim Besuch zu Hause sein?', a: 'Nein. Viele unserer Kunden leben im Ausland. Wir brauchen nur Zugang zu Pool und Technik, und Sie erhalten nach jedem Besuch einen Fotobericht.' },
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"inLanguage": "de",
	"mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
};

const schema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": site.name,
	"url": url,
	"telephone": phone,
	"description": description,
	"address": { "@type": "PostalAddress", "addressLocality": "Coral Bay", "addressRegion": "Paphos", "addressCountry": "CY" },
	"areaServed": areasEn.map(a => ({ "@type": "City", "name": a })),
	"serviceType": "Poolreinigung und Poolpflege",
	"availableLanguage": ["de", "en", "el"],
};
---

<!DOCTYPE html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.name} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={url} />
		{alternates('paphos').map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
		<meta name="geo.region" content="CY-05" />
		<meta name="geo.placename" content="Paphos" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={url} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<ClientRouter />

		<style>
			:root {
				--deep:  #072A38;
				--water: #1B7A9E;
				--aqua:  #6FD4E4;
				--tile:  #F2F9FB;
				--sun:   #FFC93C;
				--ink:   #0A2530;
				--muted: #3D6272;
				--font-display: "Bricolage Grotesque", sans-serif;
				--font-body:    "Inter", sans-serif;
				--radius: 14px;
				--maxw:   1080px;
			}

			*, *::before, *::after { box-sizing: border-box; margin: 0; }
			html { scroll-behavior: smooth; }
			body { font-family: var(--font-body); color: var(--ink); background: var(--tile); line-height: 1.6; }
			.wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 24px; }
			a { color: inherit; }
			a:focus-visible, button:focus-visible { outline: 3px solid var(--sun); outline-offset: 2px; }

			.tile-strip {
				height: 14px;
				background: repeating-linear-gradient(90deg, var(--aqua) 0 22px, var(--tile) 22px 26px, var(--water) 26px 48px, var(--tile) 48px 52px);
			}

			.btn {
				display: inline-flex; align-items: center; border: none; cursor: pointer;
				font-family: var(--font-body); font-weight: 600; font-size: 1rem;
				padding: 13px 26px; border-radius: 999px; text-decoration: none;
				transition: transform .15s ease, box-shadow .15s ease;
			}
			.btn:hover { transform: translateY(-2px); }
			.btn-sun { background: var(--sun); color: var(--ink); box-shadow: 0 4px 14px rgba(255,201,60,.4); }
			.btn-ghost { background: transparent; color: var(--tile); border: 2px solid rgba(242,249,251,.5); }
			.btn-ghost:hover { border-color: var(--tile); }

			/* hero */
			.hero {
				background: var(--deep);
				color: var(--tile); position: relative; overflow: hidden; padding-top: 64px;
			}
			.hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
			.hero-overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(7,42,56,.82) 0%, rgba(7,42,56,.55) 45%, rgba(7,42,56,.12) 100%); }
			.hero-inner { padding: 80px 24px 140px; max-width: var(--maxw); margin: 0 auto; position: relative; z-index: 1; }
			.eyebrow { display: inline-block; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; font-weight: 600; color: var(--aqua); margin-bottom: 16px; }
			h1 { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.4rem, 5vw, 3.8rem); line-height: 1.05; margin-bottom: 20px; max-width: 18ch; }
			h1 .accent { color: var(--sun); }
			.hero-desc { font-size: 1.1rem; max-width: 56ch; color: #CFE8F0; margin-bottom: 16px; line-height: 1.7; }
			.hero-desc strong { color: #fff; }
			.hero-ctas { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 16px; }

			.wave { position: absolute; bottom: -2px; left: 0; width: 200%; height: 90px; animation: drift 14s linear infinite; }
			@keyframes drift { from { transform: translateX(0); } to { transform: translateX(-50%); } }

			/* sections */
			section { padding: 88px 0; }
			.section-head { max-width: 62ch; margin-bottom: 48px; }
			h2 { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.8rem, 3.5vw, 2.5rem); line-height: 1.15; margin-bottom: 12px; }
			.section-head p, .lead { color: var(--muted); font-size: 1.05rem; line-height: 1.75; }
			.lead + .lead { margin-top: 16px; }

			.intro-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 48px; align-items: center; }
			.intro-photo { width: 100%; max-width: 420px; height: auto; mix-blend-mode: multiply; display: block; justify-self: center; }
			.services { background: #fff; }
			.svc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
			.svc-card { background: var(--tile); border: 1px solid #DCEBF0; border-radius: var(--radius); padding: 28px; }
			.icon-box { width: 44px; height: 44px; border-radius: 12px; background: var(--aqua); display: grid; place-items: center; margin-bottom: 16px; }
			.svc-card h3, .why-card h3 { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; margin-bottom: 8px; color: var(--ink); }
			.svc-card p, .why-card p { color: var(--muted); font-size: .95rem; line-height: 1.65; }

			.split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
			.chips { display: flex; flex-wrap: wrap; gap: 10px; margin: 20px 0; }
			.chip { background: #fff; border: 1px solid #DCEBF0; border-radius: 999px; padding: 8px 16px; font-size: .92rem; font-weight: 500; color: var(--ink); display: inline-flex; align-items: center; gap: 6px; }
			.note { color: var(--muted); font-size: .95rem; }

			.plans { background: linear-gradient(175deg, var(--water) 0%, var(--deep) 100%); color: var(--tile); }
			.plans h2 { color: #fff; }
			.plans .section-head p { color: #CFE8F0; }
			.plan-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 760px; margin-bottom: 28px; }
			.plan { background: var(--tile); color: var(--ink); border-radius: var(--radius); padding: 28px; box-shadow: 0 24px 60px rgba(0,0,0,.25); }
			.plan .tag { font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; font-weight: 600; color: var(--water); }
			.plan h3 { font-family: var(--font-display); font-size: 1.4rem; font-weight: 800; margin: 6px 0 4px; }
			.plan .price { font-family: var(--font-display); font-size: 2.2rem; font-weight: 800; }
			.plan .price small { font-family: var(--font-body); font-size: .9rem; font-weight: 500; color: var(--muted); }
			.plan p { color: var(--muted); font-size: .92rem; margin-top: 10px; }
			.plans .fine { color: #CFE8F0; max-width: 62ch; line-height: 1.7; }
			.plans .fine + .fine { margin-top: 12px; }

			.why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
			.why-card { background: #fff; border: 1px solid #DCEBF0; border-radius: var(--radius); padding: 24px 20px; }
			.why-card h3 { font-size: 1rem; }
			.why-card p { font-size: .875rem; }

			.faq-list { max-width: 820px; display: grid; gap: 12px; }
			.faq-item { background: #fff; border: 1px solid #DCEBF0; border-radius: var(--radius); padding: 0 22px; }
			.faq-item summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 0; font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; }
			.faq-item summary::-webkit-details-marker { display: none; }
			.faq-item[open] summary :global(svg) { transform: rotate(180deg); }
			.faq-item p { color: var(--muted); padding-bottom: 18px; line-height: 1.7; }

			.quote { background: #fff; text-align: center; }
			.quote .section-head { margin-left: auto; margin-right: auto; }
			.quote .hero-ctas { justify-content: center; }
			.quote .btn-ghost { color: var(--ink); border-color: var(--water); }
			.quote strong.cta-line { display: block; margin-top: 16px; font-family: var(--font-display); font-size: 1.15rem; }

			footer { background: var(--deep); color: #9FC6D3; padding: 40px 0; font-size: .9rem; }
			.foot { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
			footer a { color: #CFE8F0; text-decoration: none; margin-left: 20px; }
			footer a:hover { color: var(--sun); }

			@media (max-width: 860px) {
				.svc-grid, .split, .plan-grid, .intro-grid { grid-template-columns: 1fr; }
				.intro-photo { max-width: 260px; }
				.split { gap: 32px; }
				.why-grid { grid-template-columns: 1fr 1fr; }
			}
			@media (max-width: 640px) {
				section { padding: 64px 0; }
				.hero-inner { padding: 60px 24px 120px; }
				.why-grid { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>
		<div class="tile-strip" aria-hidden="true"></div>
		<Navbar />

		<header class="hero">
			<img src="/vrysoudion-street-paphos.webp" alt="Vrysoudion-Straße, Paphos – Blick über die Stadt und das Meer" class="hero-bg" width="1000" height="750" fetchpriority="high" />
			<div class="hero-overlay" aria-hidden="true"></div>
			<div class="hero-inner">
				<div class="hero-copy">
				<span class="eyebrow">Coral Bay · Peyia · Paphos</span>
				<h1>Poolreinigung Paphos – <span class="accent">Professionelle Poolpflege</span></h1>
				<p class="hero-desc">Sie suchen eine zuverlässige <strong>Poolreinigung in Paphos</strong>? Pool Cleaning Cyprus bietet professionelle Reinigung und Pflege von Swimmingpools für Privathäuser, Villen, Ferienunterkünfte und Gewerbeobjekte im gesamten Raum Paphos.</p>
				<p class="hero-desc">Wir kümmern uns um alles, was Ihr Pool braucht, um sauber, klar und sicher zu bleiben. Von der wöchentlichen Reinigung und Wassertests über den chemischen Ausgleich bis zu Filterpflege und Technikprüfungen halten unsere Pooltechniker Ihren Pool das ganze Jahr über in bestem Zustand.</p>
				<p class="hero-desc">Von Coral Bay aus betreuen wir Paphos und die Umgebung mit zuverlässigen festen Terminen, transparenten Preisen und einem Fotobericht nach jeder Reinigung.</p>
				<div class="hero-ctas">
					<a class="btn btn-sun" href={`tel:${phone}`}>Rufen Sie uns an {phone.replace('+357', '')}</a>
					<a class="btn btn-ghost" href={whatsapp} target="_blank" rel="noopener noreferrer">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align:middle;margin-right:6px;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>Per WhatsApp fragen
					</a>
				</div>
				</div>
			</div>
			<svg class="wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
				<path d="M0,45 C120,80 240,10 360,45 C480,80 600,10 720,45 C840,80 960,10 1080,45 C1200,80 1320,10 1440,45 L1440,90 L0,90 Z M1440,45 C1560,80 1680,10 1800,45 C1920,80 2040,10 2160,45 C2280,80 2400,10 2520,45 C2640,80 2760,10 2880,45 L2880,90 L1440,90 Z" fill="#F2F9FB"/>
			</svg>
		</header>

		<section>
			<div class="wrap intro-grid">
				<div class="section-head" style="margin-bottom:0">
					<h2>Professionelle Poolreinigung in Paphos</h2>
					<p class="lead">Einen Swimmingpool auf Zypern sauber zu halten, erfordert regelmäßige Aufmerksamkeit. Hohe Sommertemperaturen, starke UV-Strahlung, Staub und hartes Wasser beeinträchtigen schnell die Wasserqualität und belasten zusätzlich die Pooltechnik.</p>
					<p class="lead">Unsere Poolpflege ist auf diese lokalen Bedingungen ausgelegt. Jeder Besuch folgt einer festen Reinigungs- und Wartungsroutine, die typische Poolprobleme verhindert und Ihr Wasser badebereit hält.</p>
				</div>
				<img src="/team-photo.png" alt="Techniker von Pool Cleaning Cyprus in Paphos" class="intro-photo" width="420" height="630" loading="lazy" />
			</div>
