---
import Navbar from '../components/Navbar.astro';
import { ClientRouter } from 'astro:transitions';

const siteTitle = "Pool Cleaning Cyprus | Professional Swimming Pool Services";
const siteDescription = "Professional pool cleaning and maintenance services across Cyprus. Crystal clear pools in Limassol, Nicosia, Paphos, and Larnaca. Reliable, affordable, and thorough.";
const siteUrl = "https://poolcleaningcyprus.com";
const siteName = "Pool Cleaning Cyprus";
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{siteTitle}</title>
		<meta name="description" content={siteDescription} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={siteUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:title" content={siteTitle} />
		<meta property="og:description" content={siteDescription} />
		<meta property="og:site_name" content={siteName} />
		<meta name="geo.region" content="CY" />
		<meta name="geo.placename" content="Cyprus" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />

		<script type="application/ld+json" is:inline>
		{
			"@context": "https://schema.org",
			"@type": "LocalBusiness",
			"name": "Pool Cleaning Cyprus",
			"description": "Professional swimming pool cleaning and maintenance services across Cyprus.",
			"url": "https://poolcleaningcyprus.com",
			"telephone": "+357-00-000000",
			"email": "hello@poolcleaningcyprus.com",
			"address": { "@type": "PostalAddress", "addressLocality": "Limassol", "addressCountry": "CY" },
			"areaServed": ["Limassol", "Nicosia", "Paphos", "Larnaca", "Famagusta"],
			"serviceType": "Pool Cleaning and Maintenance"
		}
		</script>

		<style>
			*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
			html { scroll-behavior: smooth; }

			body {
				font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
				background: #f0f9ff;
				color: #0c1a2e;
				overflow-x: hidden;
				line-height: 1.6;
			}
			:global(html.dark) body { background: #050f1a; color: #e0f2fe; }

			/* ─────────────────────── HERO ─────────────────────── */
			.hero {
				background: #0a1628;
				position: relative;
				overflow: hidden;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}

			.hero::before {
				content: '';
				position: absolute;
				inset: 0;
				background:
					radial-gradient(ellipse 90% 60% at 50% -5%, rgba(6,182,212,0.22) 0%, transparent 60%),
					radial-gradient(ellipse 50% 50% at 90% 100%, rgba(14,165,233,0.12) 0%, transparent 55%),
					radial-gradient(ellipse 40% 40% at 0% 70%, rgba(6,182,212,0.08) 0%, transparent 50%);
				pointer-events: none;
			}

			/* Subtle grid overlay */
			.hero::after {
				content: '';
				position: absolute;
				inset: 0;
				background-image:
					linear-gradient(rgba(56,189,248,0.04) 1px, transparent 1px),
					linear-gradient(90deg, rgba(56,189,248,0.04) 1px, transparent 1px);
				background-size: 60px 60px;
				pointer-events: none;
			}

			.hero-inner {
				flex: 1;
				position: relative;
				z-index: 1;
				max-width: 1160px;
				margin: 0 auto;
				width: 100%;
				padding: 160px 2rem 100px;
				display: grid;
				grid-template-columns: 1fr 420px;
				gap: 4rem;
				align-items: center;
			}

			.hero-eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: #06b6d4;
				margin-bottom: 1.4rem;
			}

			.eyebrow-line {
				width: 28px;
				height: 2px;
				background: #06b6d4;
				border-radius: 2px;
			}

			h1 {
				font-size: clamp(2.8rem, 5.5vw, 4.6rem);
				font-weight: 900;
				line-height: 1.05;
				letter-spacing: -0.03em;
				color: #fff;
				margin-bottom: 1.4rem;
			}

			h1 .highlight {
				position: relative;
				color: #0c1a2e;
				display: inline-block;
				padding: 0 10px;
				margin: 0 2px;
				white-space: nowrap;
			}

			h1 .highlight::before {
				content: '';
				position: absolute;
				inset: 0;
				background: #06b6d4;
				border-radius: 6px;
				z-index: -1;
				transform: rotate(-1deg) skewX(-2deg);
			}

			h1 .highlight-2 {
				position: relative;
				color: #06b6d4;
				display: inline-block;
			}

			h1 .highlight-2::after {
				content: '';
				position: absolute;
				bottom: 2px;
				left: 0;
				right: 0;
				height: 4px;
				background: #06b6d4;
				border-radius: 2px;
				opacity: 0.6;
			}

			.hero-desc {
				font-size: 1.05rem;
				line-height: 1.8;
				color: rgba(186,230,253,0.65);
				margin-bottom: 2.4rem;
				max-width: 500px;
			}

			.hero-cta-row {
				display: flex;
				gap: 14px;
				flex-wrap: wrap;
				margin-bottom: 3.5rem;
			}

			.btn-primary {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 15px 32px;
				background: #06b6d4;
				color: #0a1628;
				border-radius: 10px;
				font-size: 0.95rem;
				font-weight: 700;
				text-decoration: none;
				letter-spacing: 0.01em;
				box-shadow: 0 4px 24px rgba(6,182,212,0.45), 0 0 0 0 rgba(6,182,212,0.3);
				transition: all 0.2s ease;
			}

			.btn-primary:hover {
				background: #0891b2;
				color: #fff;
				transform: translateY(-2px);
				box-shadow: 0 8px 32px rgba(6,182,212,0.5);
			}

			.btn-outline {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 15px 32px;
				border: 1.5px solid rgba(56,189,248,0.35);
				color: #7dd3fc;
				border-radius: 10px;
				font-size: 0.95rem;
				font-weight: 600;
				text-decoration: none;
				transition: all 0.2s ease;
			}

			.btn-outline:hover {
				border-color: #06b6d4;
				color: #06b6d4;
				background: rgba(6,182,212,0.08);
			}

			.hero-stats {
				display: flex;
				gap: 2.5rem;
				padding-top: 1rem;
				border-top: 1px solid rgba(56,189,248,0.12);
			}

			.stat-num {
				font-size: 1.8rem;
				font-weight: 800;
				color: #fff;
				letter-spacing: -0.03em;
				line-height: 1;
				margin-bottom: 4px;
			}

			.stat-num span { color: #06b6d4; }

			.stat-label {
				font-size: 0.7rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: rgba(186,230,253,0.45);
			}

			/* Hero visual card */
			.hero-card {
				background: rgba(255,255,255,0.04);
				border: 1px solid rgba(56,189,248,0.15);
				border-radius: 24px;
				padding: 2rem;
				backdrop-filter: blur(10px);
				position: relative;
			}

			.hero-card::before {
				content: '';
				position: absolute;
				top: -1px; left: -1px; right: -1px;
				height: 2px;
				background: linear-gradient(90deg, transparent, #06b6d4, transparent);
				border-radius: 24px 24px 0 0;
			}

			.hero-card-title {
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: #06b6d4;
				margin-bottom: 1.4rem;
			}

			.pool-svg-wrap {
				background: rgba(6,182,212,0.06);
				border: 1px solid rgba(6,182,212,0.15);
				border-radius: 16px;
				padding: 1.5rem;
				margin-bottom: 1.5rem;
				display: flex;
				justify-content: center;
			}

			.hero-feature-list {
				list-style: none;
				display: flex;
				flex-direction: column;
				gap: 10px;
			}

			.hero-feature-list li {
				display: flex;
				align-items: center;
				gap: 10px;
				font-size: 0.875rem;
				color: rgba(186,230,253,0.8);
			}

			.check-icon {
				width: 20px;
				height: 20px;
				background: rgba(6,182,212,0.15);
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
			}

			.badge {
				position: absolute;
				top: -16px;
				right: -16px;
				background: #0891b2;
				border: 2px solid #0a1628;
				border-radius: 14px;
				padding: 8px 14px;
				font-size: 0.72rem;
				font-weight: 700;
				color: #fff;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				white-space: nowrap;
			}

			.badge strong { color: #a5f3fc; font-size: 1rem; display: block; }

			/* ─────────────────────── SHARED SECTION ─────────────────────── */
			section { padding: 5rem 1.5rem; }

			.section-inner { max-width: 1100px; margin: 0 auto; }

			.section-header { text-align: center; margin-bottom: 3.5rem; }

			.section-tag {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #0891b2;
				margin-bottom: 0.9rem;
			}

			.section-tag::before, .section-tag::after {
				content: '';
				width: 20px;
				height: 1.5px;
				background: currentColor;
				border-radius: 2px;
				opacity: 0.5;
			}

			:global(html.dark) .section-tag { color: #06b6d4; }

			h2 {
				font-size: clamp(1.8rem, 4vw, 2.6rem);
				font-weight: 800;
				letter-spacing: -0.03em;
				color: #0c1a2e;
				margin-bottom: 0.8rem;
				line-height: 1.15;
			}

			:global(html.dark) h2 { color: #e0f2fe; }

			.section-divider {
				width: 36px;
				height: 3px;
				background: #06b6d4;
				border-radius: 2px;
				margin: 0.9rem auto 1.2rem;
			}

			.section-desc {
				font-size: 1rem;
				color: #64748b;
				max-width: 540px;
				margin: 0 auto;
				line-height: 1.75;
			}
			:global(html.dark) .section-desc { color: #94a3b8; }

			/* ─────────────────────── SERVICES ─────────────────────── */
			.services { background: #fff; }
			:global(html.dark) .services { background: #071829; }

			.services-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem;
			}

			.service-card {
				background: #f8fafc;
				border: 1.5px solid #e2e8f0;
				border-radius: 20px;
				padding: 2rem 1.6rem;
				transition: all 0.25s ease;
				position: relative;
				overflow: hidden;
			}

			.service-card::before {
				content: '';
				position: absolute;
				top: 0; left: 0; right: 0;
				height: 3px;
				background: linear-gradient(90deg, #06b6d4, #0ea5e9);
				opacity: 0;
				transition: opacity 0.25s ease;
			}

			.service-card:hover {
				border-color: rgba(6,182,212,0.4);
				transform: translateY(-4px);
				box-shadow: 0 12px 36px rgba(6,182,212,0.12);
			}

			.service-card:hover::before { opacity: 1; }

			:global(html.dark) .service-card {
				background: rgba(14,42,71,0.45);
				border-color: rgba(56,189,248,0.1);
			}

			:global(html.dark) .service-card:hover {
				border-color: rgba(6,182,212,0.35);
			}

			.service-icon-wrap {
				width: 56px;
				height: 56px;
				border-radius: 16px;
				background: linear-gradient(135deg, #06b6d4, #0ea5e9);
				display: flex;
				align-items: center;
				justify-content: center;
				margin-bottom: 1.2rem;
				box-shadow: 0 6px 20px rgba(6,182,212,0.3);
			}

			.service-card h3 {
				font-size: 1rem;
				font-weight: 700;
				color: #0c1a2e;
				margin-bottom: 0.5rem;
				letter-spacing: -0.01em;
			}
			:global(html.dark) .service-card h3 { color: #e0f2fe; }

			.service-card p {
				font-size: 0.875rem;
				color: #64748b;
				line-height: 1.65;
			}

			/* ─────────────────────── PRICING ─────────────────────── */
			.pricing { background: #f0f9ff; }
			:global(html.dark) .pricing { background: #050f1a; }

			.pricing-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem;
				align-items: stretch;
			}

			.price-card {
				background: #fff;
				border: 1.5px solid #e2e8f0;
				border-radius: 24px;
				padding: 2.2rem 2rem;
				display: flex;
				flex-direction: column;
				transition: all 0.25s ease;
				position: relative;
			}

			.price-card:hover {
				transform: translateY(-4px);
				box-shadow: 0 12px 40px rgba(6,182,212,0.1);
			}

			:global(html.dark) .price-card {
				background: rgba(14,42,71,0.45);
				border-color: rgba(56,189,248,0.1);
			}

			.price-card.featured {
				background: linear-gradient(160deg, #0a1e3a 0%, #0c2347 100%);
				border-color: #06b6d4;
				border-width: 2px;
				box-shadow: 0 20px 60px rgba(6,182,212,0.25);
				transform: scale(1.04);
			}

			.price-card.featured:hover {
				transform: scale(1.04) translateY(-4px);
			}

			:global(html.dark) .price-card.featured {
				background: linear-gradient(160deg, #061428 0%, #0a1e38 100%);
			}

			.price-badge {
				position: absolute;
				top: -14px;
				left: 50%;
				transform: translateX(-50%);
				background: #06b6d4;
				color: #0a1628;
				font-size: 0.7rem;
				font-weight: 800;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				padding: 5px 16px;
				border-radius: 50px;
				white-space: nowrap;
			}

			.price-tier {
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: #06b6d4;
				margin-bottom: 0.5rem;
			}

			.price-name {
				font-size: 1.4rem;
				font-weight: 800;
				color: #0c1a2e;
				margin-bottom: 0.4rem;
			}
			.price-card.featured .price-name { color: #fff; }
			:global(html.dark) .price-name { color: #e0f2fe; }

			.price-amount {
				font-size: 2.4rem;
				font-weight: 900;
				color: #0c1a2e;
				letter-spacing: -0.04em;
				line-height: 1;
				margin-bottom: 0.3rem;
			}
			.price-card.featured .price-amount { color: #fff; }
			:global(html.dark) .price-amount { color: #e0f2fe; }

			.price-amount sup { font-size: 1.2rem; font-weight: 700; vertical-align: super; }
			.price-amount sub { font-size: 0.85rem; font-weight: 500; opacity: 0.6; letter-spacing: 0; }

			.price-note {
				font-size: 0.78rem;
				color: #94a3b8;
				margin-bottom: 1.5rem;
			}
			.price-card.featured .price-note { color: rgba(186,230,253,0.55); }

			.price-divider {
				height: 1px;
				background: #e2e8f0;
				margin-bottom: 1.5rem;
			}
			.price-card.featured .price-divider { background: rgba(56,189,248,0.2); }
			:global(html.dark) .price-divider { background: rgba(56,189,248,0.1); }

			.price-features {
				list-style: none;
				display: flex;
				flex-direction: column;
				gap: 10px;
				flex: 1;
				margin-bottom: 2rem;
			}

			.price-features li {
				display: flex;
				align-items: flex-start;
				gap: 10px;
				font-size: 0.875rem;
				color: #475569;
				line-height: 1.5;
			}
			.price-card.featured .price-features li { color: rgba(186,230,253,0.8); }
			:global(html.dark) .price-features li { color: #94a3b8; }

			.price-features li::before {
				content: '';
				width: 18px;
				height: 18px;
				min-width: 18px;
				background: rgba(6,182,212,0.12);
				border-radius: 50%;
				background-image: url("data:image/svg+xml,%3Csvg width='10' height='10' viewBox='0 0 12 12' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 6L5 9L10 3' stroke='%2306b6d4' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
				background-repeat: no-repeat;
				background-position: center;
				margin-top: 2px;
			}

			.price-card.featured .price-features li::before {
				background-color: rgba(6,182,212,0.2);
			}

			.price-cta {
				display: block;
				text-align: center;
				padding: 13px;
				border-radius: 12px;
				font-size: 0.9rem;
				font-weight: 700;
				text-decoration: none;
				transition: all 0.2s ease;
				border: 1.5px solid rgba(6,182,212,0.3);
				color: #0891b2;
			}

			.price-cta:hover {
				background: rgba(6,182,212,0.08);
				border-color: #06b6d4;
			}

			:global(html.dark) .price-cta {
				color: #38bdf8;
				border-color: rgba(56,189,248,0.25);
			}

			.price-card.featured .price-cta {
				background: #06b6d4;
				border-color: #06b6d4;
				color: #0a1628;
				font-weight: 800;
				box-shadow: 0 4px 20px rgba(6,182,212,0.4);
			}

			.price-card.featured .price-cta:hover {
				background: #0891b2;
				color: #fff;
			}

			/* ─────────────────────── HOW IT WORKS ─────────────────────── */
			.how-it-works { background: #fff; }
			:global(html.dark) .how-it-works { background: #071829; }

			.steps-row {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2rem;
				position: relative;
			}

			.steps-row::before {
				content: '';
				position: absolute;
				top: 44px;
				left: calc(16.66% + 44px);
				right: calc(16.66% + 44px);
				height: 2px;
				background: linear-gradient(90deg, #06b6d4, #0ea5e9, #06b6d4);
				opacity: 0.25;
			}

			.step {
				text-align: center;
				padding: 0 1rem;
				position: relative;
			}

			.step-icon {
				width: 88px;
				height: 88px;
				border-radius: 50%;
				margin: 0 auto 1.4rem;
				display: flex;
				align-items: center;
				justify-content: center;
				position: relative;
			}

			.step-icon.blue { background: linear-gradient(135deg, #06b6d4, #0ea5e9); box-shadow: 0 8px 28px rgba(6,182,212,0.35); }
			.step-icon.navy { background: #0c1a2e; box-shadow: 0 8px 28px rgba(12,26,46,0.3); }
			:global(html.dark) .step-icon.navy { background: #0a2040; }
			.step-icon.outline { background: transparent; border: 2px solid rgba(6,182,212,0.35); }

			.step-num {
				position: absolute;
				top: -6px;
				right: -6px;
				width: 24px;
				height: 24px;
				background: #06b6d4;
				border-radius: 50%;
				font-size: 0.7rem;
				font-weight: 800;
				color: #0a1628;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.step h3 {
				font-size: 1.05rem;
				font-weight: 700;
				color: #0c1a2e;
				margin-bottom: 0.5rem;
			}
			:global(html.dark) .step h3 { color: #e0f2fe; }

			.step p {
				font-size: 0.875rem;
				color: #64748b;
				line-height: 1.65;
			}
			:global(html.dark) .step p { color: #94a3b8; }

			/* ─────────────────────── WHY US ─────────────────────── */
			.why-us {
				background: #0a1628;
				position: relative;
				overflow: hidden;
			}

