---
import Navbar from '../components/Navbar.astro';
import { ClientRouter } from 'astro:transitions';

const siteTitle = "Pool Cleaning Cyprus | Professional Swimming Pool Services";
const siteDescription = "Professional pool cleaning and maintenance services across Cyprus. Crystal clear pools in Limassol, Nicosia, Paphos, and Larnaca. Reliable, affordable, and thorough.";
const siteUrl = "https://poolcleaningcyprus.com";
const siteName = "Pool Cleaning Cyprus";
const siteKeywords = "pool cleaning cyprus, swimming pool maintenance cyprus, pool service limassol, pool cleaning paphos, pool maintenance nicosia, larnaca pool cleaning, pool chemicals cyprus, pool repair cyprus";
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />

		<title>{siteTitle}</title>
		<meta name="title" content={siteTitle} />
		<meta name="description" content={siteDescription} />
		<meta name="keywords" content={siteKeywords} />
		<meta name="author" content={siteName} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={siteUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:title" content={siteTitle} />
		<meta property="og:description" content={siteDescription} />
		<meta property="og:image" content={`${siteUrl}/og-image.jpg`} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_CY" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={siteTitle} />
		<meta name="twitter:description" content={siteDescription} />
		<meta name="twitter:image" content={`${siteUrl}/og-image.jpg`} />

		<meta name="geo.region" content="CY" />
		<meta name="geo.placename" content="Cyprus" />
		<meta name="geo.position" content="35.1264;33.4299" />
		<meta name="ICBM" content="35.1264, 33.4299" />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<meta name="generator" content={Astro.generator} />
		<ClientRouter />

		<script type="application/ld+json" is:inline>
		{
			"@context": "https://schema.org",
			"@type": "LocalBusiness",
			"name": "Pool Cleaning Cyprus",
			"description": "Professional swimming pool cleaning and maintenance services across Cyprus.",
			"url": "https://poolcleaningcyprus.com",
			"telephone": "+357-00-000000",
			"email": "hello@poolcleaningcyprus.com",
			"address": { "@type": "PostalAddress", "addressLocality": "Limassol", "addressCountry": "CY" },
			"areaServed": ["Limassol", "Nicosia", "Paphos", "Larnaca", "Famagusta"],
			"serviceType": "Pool Cleaning and Maintenance"
		}
		</script>

		<style>
			:root {
				--deep:   #072A38;
				--water:  #1B7A9E;
				--aqua:   #6FD4E4;
				--tile:   #F2F9FB;
				--sun:    #FFC93C;
				--ink:    #0A2530;
				--muted:  #3D6272;

				--font-display: "Bricolage Grotesque", sans-serif;
				--font-body:    "Inter", sans-serif;

				--radius: 14px;
				--maxw:   1080px;
			}

			*, *::before, *::after { box-sizing: border-box; margin: 0; }
			html { scroll-behavior: smooth; }

			@media (prefers-reduced-motion: reduce) {
				html { scroll-behavior: auto; }
				*, *::before, *::after { animation: none !important; transition: none !important; }
			}

			body {
				font-family: var(--font-body);
				color: var(--ink);
				background: var(--tile);
				line-height: 1.6;
			}

			.wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 24px; }
			a { color: inherit; }
			a:focus-visible, button:focus-visible { outline: 3px solid var(--sun); outline-offset: 2px; }

			/* ── tile strip ── */
			.tile-strip {
				height: 14px;
				background:
					repeating-linear-gradient(90deg,
						var(--aqua)  0 22px,
						var(--tile) 22px 26px,
						var(--water) 26px 48px,
						var(--tile) 48px 52px);
			}

			/* ── buttons ── */
			.btn {
				display: inline-block;
				border: none;
				cursor: pointer;
				font-family: var(--font-body);
				font-weight: 600;
				font-size: 1rem;
				padding: 13px 26px;
				border-radius: 999px;
				text-decoration: none;
				transition: transform .15s ease, box-shadow .15s ease;
			}
			.btn:hover { transform: translateY(-2px); }
			.btn-sun  { background: var(--sun);   color: var(--ink); box-shadow: 0 4px 14px rgba(255,201,60,.4); }
			.btn-ghost { background: transparent; color: var(--tile); border: 2px solid rgba(242,249,251,.5); }
			.btn-ghost:hover { border-color: var(--tile); }
			.btn-water { background: var(--water); color: #fff; text-align: center; }

			/* ── hero ── */
			.hero {
				background: linear-gradient(175deg, var(--water) 0%, var(--deep) 85%);
				color: var(--tile);
				position: relative;
				overflow: hidden;
				padding-top: 64px; /* navbar offset */
			}

			.hero-inner {
				padding: 80px 24px 140px;
				max-width: var(--maxw);
				margin: 0 auto;
				display: grid;
				grid-template-columns: 1.15fr .85fr;
				gap: 48px;
				align-items: center;
			}

			.eyebrow {
				display: inline-block;
				font-size: .8rem;
				letter-spacing: .12em;
				text-transform: uppercase;
				font-weight: 600;
				color: var(--aqua);
				margin-bottom: 16px;
			}

			h1 {
				font-family: var(--font-display);
				font-weight: 800;
				font-size: clamp(2.4rem, 5vw, 3.8rem);
				line-height: 1.05;
				margin-bottom: 20px;
			}

			h1 .accent { color: var(--sun); }

			.hero-desc {
				font-size: 1.1rem;
				max-width: 46ch;
				color: #CFE8F0;
				margin-bottom: 32px;
				line-height: 1.7;
			}

			.hero-ctas { display: flex; gap: 16px; flex-wrap: wrap; }

			/* report card */
			.report-card {
				background: var(--tile);
				color: var(--ink);
				border-radius: var(--radius);
				padding: 28px;
				box-shadow: 0 24px 60px rgba(0,0,0,.35);
				transform: rotate(2deg);
			}

			.report-card h3 {
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 1.05rem;
				margin-bottom: 14px;
				color: var(--ink);
			}

			.report-row {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 10px 0;
				border-bottom: 1px dashed #D3E5EB;
				font-size: .92rem;
				color: var(--ink);
			}

			.report-row:last-child { border-bottom: none; }

			.pill {
				font-size: .75rem;
				font-weight: 600;
				padding: 3px 10px;
				border-radius: 999px;
			}

			.pill.ok  { background: #DCF5E5; color: #176B3A; }
			.pill.fix { background: #FFF1CC; color: #8A6100; }

			/* wave divider */
			.wave {
				position: absolute;
				bottom: -2px;
				left: 0;
				width: 200%;
				height: 90px;
				animation: drift 14s linear infinite;
			}

			@keyframes drift {
				from { transform: translateX(0); }
				to   { transform: translateX(-50%); }
			}

			/* ── shared section ── */
			section { padding: 88px 0; }

			.section-head { max-width: 56ch; margin-bottom: 48px; }

			h2 {
				font-family: var(--font-display);
				font-weight: 800;
				font-size: clamp(1.8rem, 3.5vw, 2.5rem);
				line-height: 1.15;
				margin-bottom: 12px;
			}

			.section-head p { color: var(--muted); font-size: 1.05rem; }

			/* ── services ── */
			.services { background: #fff; }

			.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

			.card {
				background: #fff;
				border: 1px solid #DCEBF0;
				border-radius: var(--radius);
				padding: 28px;
				transition: transform .15s ease, box-shadow .15s ease;
			}

			.card:hover {
				transform: translateY(-4px);
				box-shadow: 0 12px 30px rgba(7,42,56,.1);
			}

			.card .icon {
				width: 48px;
				height: 48px;
				border-radius: 12px;
				background: var(--aqua);
				display: grid;
				place-items: center;
				margin-bottom: 18px;
			}

			.card h3 {
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 1.1rem;
				margin-bottom: 8px;
				color: var(--ink);
			}

			.card p { font-size: .95rem; color: var(--muted); }

			/* ── how it works ── */
			.how { background: var(--deep); color: var(--tile); }
			.how h2 { color: var(--tile); }
			.how .section-head p { color: #9FC6D3; }

			.steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

			.step { border-top: 3px solid var(--aqua); padding-top: 20px; }

			.step strong {
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 1.1rem;
				display: block;
				margin-bottom: 8px;
				color: var(--tile);
			}

			.step p { font-size: .95rem; color: #B7D8E2; }

			/* ── pricing ── */
			.pricing { background: var(--tile); }

			.plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; align-items: stretch; }

			.plan {
				background: #fff;
				border: 1px solid #DCEBF0;
				border-radius: var(--radius);
				padding: 32px 28px;
				display: flex;
				flex-direction: column;
			}

			.plan.featured { border: 2px solid var(--water); position: relative; }

			.plan.featured::before {
				content: "Most popular";
				position: absolute;
				top: -13px;
				left: 24px;
				background: var(--sun);
				color: var(--ink);
				font-size: .75rem;
				font-weight: 700;
				padding: 3px 12px;
				border-radius: 999px;
			}

			.plan h3 {
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 1.2rem;
				color: var(--ink);
			}

			.plan-note {
				font-size: .82rem;
				color: var(--muted);
				margin: 6px 0 14px;
				line-height: 1.5;
			}

			.price {
				font-family: var(--font-display);
				font-weight: 800;
				font-size: 2.6rem;
				margin: 10px 0 2px;
				color: var(--ink);
				letter-spacing: -0.02em;
			}

			.price span { font-size: 1rem; font-weight: 500; color: var(--muted); }

			.plan ul { list-style: none; padding: 0; margin: 20px 0 28px; flex: 1; }

			.plan li {
				padding: 7px 0 7px 26px;
				position: relative;
				font-size: .95rem;
				color: var(--ink);
			}

			.plan li::before {
				content: "✓";
				position: absolute;
				left: 0;
				color: var(--water);
				font-weight: 700;
			}

			.plans-note {
				text-align: center;
				margin-top: 24px;
				font-size: .9rem;
				color: var(--muted);
			}

			/* ── why us ── */
			.why { background: #fff; }

			.why-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 20px;
			}

			.why-card {
				border: 1px solid #DCEBF0;
				border-radius: var(--radius);
				padding: 28px;
				border-left: 4px solid var(--aqua);
			}

			.why-card h3 {
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 1.05rem;
				margin-bottom: 8px;
				color: var(--ink);
			}

			.why-card p { font-size: .95rem; color: var(--muted); line-height: 1.65; }

			/* ── reviews ── */
			.reviews { background: var(--tile); }

			.reviews-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 20px;
			}

			.review {
				background: #fff;
				border: 1px solid #DCEBF0;
				border-radius: var(--radius);
				padding: 28px;
			}

			.stars { color: #f59e0b; font-size: 1rem; margin-bottom: 12px; }

			.review blockquote {
				font-size: .95rem;
				color: var(--muted);
				line-height: 1.7;
				font-style: italic;
				margin-bottom: 16px;
			}

			.reviewer {
				display: flex;
				align-items: center;
				gap: 12px;
			}

			.avatar {
				width: 38px;
				height: 38px;
				border-radius: 50%;
				background: var(--water);
				color: #fff;
				font-family: var(--font-display);
				font-weight: 700;
				font-size: .8rem;
				display: grid;
				place-items: center;
				flex-shrink: 0;
			}

			.reviewer-name { font-weight: 700; font-size: .875rem; color: var(--ink); }
			.reviewer-city { font-size: .78rem; color: #94a3b8; }

			/* ── areas ── */
			.areas { background: #fff; }

			.area-chips {
				display: flex;
				flex-wrap: wrap;
				gap: 10px;
				margin-bottom: 16px;
			}

			.area-chip {
				display: flex;
				align-items: center;
				gap: 7px;
				padding: 9px 20px;
				background: var(--tile);
				border: 1.5px solid #DCEBF0;
				border-radius: 999px;
				font-size: .875rem;
				font-weight: 600;
				color: var(--ink);
				text-decoration: none;
				transition: all .15s ease;
			}

			.area-chip:hover {
				border-color: var(--water);
				background: rgba(27,122,158,.06);
				color: var(--water);
				transform: translateY(-2px);
			}

			.area-dot {
				width: 7px;
				height: 7px;
				background: var(--aqua);
				border-radius: 50%;
				flex-shrink: 0;
			}

			.areas-note { font-size: .875rem; color: var(--muted); }
			.areas-note a { color: var(--water); font-weight: 600; }

			/* ── quote / contact ── */
			.quote {
				background: linear-gradient(160deg, var(--water), var(--deep));
				color: var(--tile);
			}

			.quote-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 56px;
				align-items: start;
			}

			.quote h2 { color: var(--tile); }
			.quote .lede { color: #CFE8F0; margin-bottom: 20px; font-size: 1.05rem; }
			.quote .contact-detail { color: #9FC6D3; font-size: .95rem; margin-top: 10px; }
			.quote .contact-detail strong { color: var(--tile); }

			.quote form {
				background: var(--tile);
				border-radius: var(--radius);
				padding: 32px;
				display: grid;
				gap: 16px;
				color: var(--ink);
				box-shadow: 0 24px 60px rgba(0,0,0,.3);
			}

			label {
				font-size: .85rem;
				font-weight: 600;
				display: block;
				margin-bottom: 6px;
				color: var(--ink);
			}

			label span { font-weight: 400; color: var(--muted); }

			input, textarea {
				width: 100%;
				padding: 12px 14px;
				border: 1px solid #C6DEE6;
				border-radius: 10px;
				font: inherit;
				background: #fff;
				color: var(--ink);
			}

			input:focus, textarea:focus {
				outline: 3px solid var(--aqua);
				border-color: var(--water);
			}

			textarea { height: 100px; resize: vertical; }

			.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

			/* ── footer ── */
			footer {
				background: var(--deep);
				color: #9FC6D3;
				padding: 40px 0;
				font-size: .9rem;
			}

			.foot {
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 16px;
			}

			footer a { color: #CFE8F0; text-decoration: none; margin-left: 20px; }
			footer a:hover { color: var(--sun); }

			/* ── responsive ── */
			@media (max-width: 860px) {
				.hero-inner { grid-template-columns: 1fr; padding: 60px 24px 120px; }
				.report-card { transform: none; max-width: 420px; }
				.cards        { grid-template-columns: 1fr; }
				.steps        { grid-template-columns: 1fr; }
				.plans        { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto; }
				.quote-grid   { grid-template-columns: 1fr; }
				.why-grid     { grid-template-columns: 1fr; }
				.reviews-grid { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>

		<div class="tile-strip" aria-hidden="true"></div>
		<Navbar />

		<!-- ══ HERO ══ -->
		<header class="hero">
			<div class="hero-inner">
				<div>
					<span class="eyebrow">Weekly pool care · Licensed &amp; insured · Cyprus</span>
					<h1>Pool cleaning across Cyprus, <span class="accent">done properly.</span></h1>
					<p class="hero-desc">Weekly visits that actually happen, water chemistry that's actually tested, and a photo report after every clean so you can see the work even if you're not on the island.</p>
					<div class="hero-ctas">
						<a class="btn btn-sun" href="#quote">Get a free quote</a>
						<a class="btn btn-ghost" href="#pricing">See pricing</a>
					</div>
				</div>

				<aside class="report-card" aria-label="Sample water report">
					<h3>This week's water report</h3>
					<div class="report-row"><span>Chlorine</span><span class="pill ok">2.4 ppm · Good</span></div>
					<div class="report-row"><span>pH</span><span class="pill ok">7.5 · Good</span></div>
					<div class="report-row"><span>Alkalinity</span><span class="pill fix">78 ppm · Adjusted</span></div>
					<div class="report-row"><span>Filter pressure</span><span class="pill ok">Normal</span></div>
					<div class="report-row"><span>Next visit</span><strong>Tue, 9:00 AM</strong></div>
				</aside>
			</div>

			<svg class="wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
				<path d="M0,45 C120,80 240,10 360,45 C480,80 600,10 720,45 C840,80 960,10 1080,45 C1200,80 1320,10 1440,45 L1440,90 L0,90 Z M1440,45 C1560,80 1680,10 1800,45 C1920,80 2040,10 2160,45 C2280,80 2400,10 2520,45 C2640,80 2760,10 2880,45 L2880,90 L1440,90 Z" fill="#F2F9FB"/>
			</svg>
		</header>

		<!-- ══ SERVICES ══ -->
		<section class="services" id="services">
			<div class="wrap">
				<div class="section-head">
					<h2>Everything your pool needs, on schedule</h2>
					<p>One visit covers the full checklist — no upsells at the gate, no surprise line items.</p>
				</div>
				<div class="cards">
					<div class="card">
						<div class="icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#072A38" stroke-width="2" stroke-linecap="round">
								<path d="M3 17c2-1.5 4-1.5 6 0s4 1.5 6 0 4-1.5 6 0"/>
								<path d="M3 12c2-1.5 4-1.5 6 0s4 1.5 6 0 4-1.5 6 0"/>
							</svg>
						</div>
						<h3>Weekly cleaning</h3>
						<p>Skimming, vacuuming, brushing walls and the waterline, emptying skimmer and pump baskets — on every scheduled visit, without fail.</p>
					</div>
					<div class="card">
						<div class="icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#072A38" stroke-width="2" stroke-linecap="round">
								<path d="M9 3h6M10 3v6l-4 9a3 3 0 0 0 3 4h6a3 3 0 0 0 3-4l-4-9V3"/>
							</svg>
						</div>
						<h3>Water balancing</h3>
						<p>Cyprus tap water is hard and the summer sun burns through chlorine fast. We test pH, chlorine, alkalinity, and calcium hardness on every visit and dose before we leave.</p>
					</div>
					<div class="card">
						<div class="icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#072A38" stroke-width="2" stroke-linecap="round">
								<circle cx="12" cy="12" r="3"/>
								<path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/>
							</svg>
						</div>
						<h3>Equipment checks</h3>
						<p>Pump, filter, and baskets inspected on every visit so small issues get caught before they become expensive repairs. A pump straining is usually audible — we listen for it.</p>
					</div>
					<div class="card">
						<div class="icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#072A38" stroke-width="2" stroke-linecap="round">
								<path d="M12 3Q8 7 4 9L4 18Q8 21 12 22Q16 21 20 18L20 9Q16 7 12 3Z"/>
								<path d="M9 13L11 15L15 11"/>
							</svg>
						</div>
						<h3>Green pool recovery</h3>
						<p>Shock, brush, filter, rebalance — until it's clear. Most recoveries take two to three visits. We give you a fixed price before we start, not an open-ended hourly rate.</p>
					</div>
