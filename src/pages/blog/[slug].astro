---
import Navbar from '../../components/Navbar.astro';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map(post => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await post.render();

const siteUrl = "https://poolcleaningcyprus.com";
const siteName = "Pool Cleaning Cyprus";
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{post.data.title} | Pool Cleaning Cyprus</title>
		<meta name="description" content={post.data.description} />
		<meta name="author" content={post.data.author} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={`${siteUrl}/blog/${post.slug}/`} />
		<link rel="alternate" hreflang="en-CY" href={`${siteUrl}/blog/${post.slug}/`} />
		<link rel="alternate" hreflang="en" href={`${siteUrl}/blog/${post.slug}/`} />
		<meta name="geo.region" content="CY" />
		<meta name="geo.placename" content="Cyprus" />
		<meta property="og:title" content={post.data.title} />
		<meta property="og:description" content={post.data.description} />
		<meta property="og:type" content="article" />
		<meta property="og:url" content={`${siteUrl}/blog/${post.slug}/`} />
		<meta property="og:site_name" content={siteName} />
		<meta property="article:published_time" content={post.data.pubDate.toISOString()} />
		<meta property="article:author" content={post.data.author} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			"headline": post.data.title,
			"description": post.data.description,
			"datePublished": post.data.pubDate.toISOString(),
			"author": { "@type": "Organization", "name": post.data.author, "url": siteUrl },
			"publisher": { "@type": "Organization", "name": siteName, "url": siteUrl },
			"mainEntityOfPage": { "@type": "WebPage", "@id": `${siteUrl}/blog/${post.slug}/` }
		})} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />

		<style>
			:root {
				--deep:  #072A38;
				--water: #1B7A9E;
				--aqua:  #6FD4E4;
				--tile:  #F2F9FB;
				--sun:   #FFC93C;
				--ink:   #0A2530;
				--muted: #3D6272;

				--font-display: "Bricolage Grotesque", sans-serif;
				--font-body:    "Inter", sans-serif;

				--radius: 14px;
				--maxw:   1080px;
			}

			*, *::before, *::after { box-sizing: border-box; margin: 0; }
			html { scroll-behavior: smooth; }

			body {
				font-family: var(--font-body);
				color: var(--ink);
				background: var(--tile);
				line-height: 1.6;
			}

			.wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 24px; }
			a { color: inherit; }

			.tile-strip {
				height: 14px;
				background:
					repeating-linear-gradient(90deg,
						var(--aqua)  0 22px,
						var(--tile) 22px 26px,
						var(--water) 26px 48px,
						var(--tile) 48px 52px);
			}

			.page-section {
				padding: 100px 0 80px;
			}

			.page-inner {
				max-width: 680px;
			}

			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				font-size: .875rem;
				font-weight: 500;
				color: var(--water);
				text-decoration: none;
				margin-bottom: 40px;
				transition: gap .15s ease;
			}
			.back-link:hover { gap: 10px; }

			.post-meta {
				font-size: .78rem;
				font-weight: 600;
				color: var(--water);
				text-transform: uppercase;
				letter-spacing: .06em;
				margin-bottom: 16px;
			}

			h1 {
				font-family: var(--font-display);
				font-weight: 800;
				font-size: clamp(1.8rem, 5vw, 2.8rem);
				line-height: 1.1;
				color: var(--ink);
				margin-bottom: 32px;
			}

			.divider {
				border: none;
				border-top: 1px solid #DCEBF0;
				margin-bottom: 40px;
			}

			/* Article prose */
			.prose :global(p) {
				font-size: 1rem;
				line-height: 1.8;
				color: var(--muted);
				margin-bottom: 20px;
			}

			.prose :global(h2) {
				font-family: var(--font-display);
				font-size: 1.4rem;
				font-weight: 700;
				color: var(--ink);
				margin: 40px 0 16px;
			}

			.prose :global(h3) {
				font-family: var(--font-display);
				font-size: 1.1rem;
				font-weight: 700;
				color: var(--ink);
				margin: 28px 0 12px;
			}

			.prose :global(ul), .prose :global(ol) {
				padding-left: 24px;
				margin-bottom: 20px;
			}

			.prose :global(li) {
				font-size: 1rem;
				line-height: 1.7;
				color: var(--muted);
				margin-bottom: 6px;
			}

			.prose :global(strong) { color: var(--ink); font-weight: 600; }

			.prose :global(a) {
				color: var(--water);
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			.prose :global(blockquote) {
				border-left: 3px solid var(--aqua);
				padding-left: 20px;
				margin: 24px 0;
				color: var(--muted);
				font-style: italic;
			}

			.prose :global(table) {
				width: 100%;
				border-collapse: collapse;
				margin-bottom: 24px;
				font-size: .9rem;
			}

			.prose :global(th) {
				background: var(--deep);
				color: #CFE8F0;
				padding: 10px 14px;
				text-align: left;
				font-weight: 600;
			}

			.prose :global(td) {
				padding: 10px 14px;
				border-bottom: 1px solid #DCEBF0;
				color: var(--muted);
			}

			.prose :global(tr:nth-child(even) td) {
				background: #fff;
			}

			.prose :global(hr) {
				border: none;
				border-top: 1px solid #DCEBF0;
				margin: 40px 0;
			}

			/* Footer */
			footer {
				background: var(--deep);
				color: #9FC6D3;
				padding: 40px 0;
				font-size: .9rem;
			}

			.foot {
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 16px;
			}

			footer a { color: #CFE8F0; text-decoration: none; margin-left: 20px; }
			footer a:hover { color: var(--sun); }
		</style>
	</head>
	<body>
		<div class="tile-strip" aria-hidden="true"></div>
		<Navbar />

		<section class="page-section">
			<div class="wrap">
				<div class="page-inner">
					<a href="/blog" class="back-link">← Back to Blog</a>

					<div class="post-meta">
						{post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
						&nbsp;·&nbsp; {post.data.author}
					</div>

					<h1>{post.data.title}</h1>
					<hr class="divider" />

					<article class="prose">
						<Content />
					</article>
				</div>
			</div>
		</section>

		<div class="tile-strip" aria-hidden="true"></div>

		<footer>
			<div class="wrap foot">
				<span>&copy; {new Date().getFullYear()} Pool Cleaning Cyprus. Pool cleaning and maintenance across Cyprus.</span>
				<span>
					<a href="/#services">Services</a>
					<a href="/#pricing">Pricing</a>
					<a href="/#quote">Free quote</a>
				</span>
			</div>
		</footer>
	</body>
</html>
